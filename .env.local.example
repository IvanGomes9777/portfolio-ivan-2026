# Resend API Key — hier deinen Key einsetzen.
# Hole ihn unter https://resend.com/api-keys nach der Registrierung mit ivanvilargomes@gmail.com.
RESEND_API_KEY=re_

# Optional: erst nutzen wenn du eine eigene Domain in Resend verifiziert hast.
# RESEND_FROM=Portfolio-Kontakt <kontakt@deine-domain.de>

# Cloudflare Turnstile (Spam-Schutz fürs Kontaktformular).
# Beide Keys findest du im Cloudflare-Dashboard unter Turnstile.
# Der Spam-Schutz ist nur aktiv, wenn BEIDE gesetzt sind — sonst funktioniert
# das Formular ganz normal weiter, nur ohne Turnstile.
# WICHTIG: TURNSTILE_SECRET_KEY NIEMALS mit NEXT_PUBLIC_ prefixen.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: zusätzliche erlaubte Origins für den CSRF-Schutz der API-Routes
# (kommagetrennt). Same-Origin ist immer erlaubt; das hier nur nötig, wenn das
# Formular von einer anderen Domain aus aufgerufen wird.
# ALLOWED_ORIGINS=https://www.deine-domain.de,https://deine-domain.de

# Optional: Basis-URL der Seite (für absolute Links, z. B. das Logo in der
# Anfrage-E-Mail). Default ist die Vercel-Production-URL.
# NEXT_PUBLIC_BASE_URL=https://www.deine-domain.de
