# Resend API Key — hier deinen Key einsetzen.
# Hole ihn unter https://resend.com/api-keys nach der Registrierung mit ivanvilargomes@gmail.com.
RESEND_API_KEY=re_

# Optional: erst nutzen wenn du eine eigene Domain in Resend verifiziert hast.
# RESEND_FROM=Portfolio-Kontakt <kontakt@deine-domain.de>

# Optional: zusätzliche erlaubte Origins für den CSRF-Schutz der API-Routes
# (kommagetrennt). Same-Origin ist immer erlaubt; das hier nur nötig, wenn das
# Formular von einer anderen Domain aus aufgerufen wird.
# ALLOWED_ORIGINS=https://www.deine-domain.de,https://deine-domain.de

# Google Tag Manager Container-ID. Trage hier deine echte ID ein (Format
# GTM-XXXXXXX) — sie steht im GTM-Dashboard oben neben dem Container-Namen.
# Ohne gesetzte Variable wird GTM nicht geladen (z.B. lokal / in Previews).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
